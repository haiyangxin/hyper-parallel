ARG AGENT_BASE=hyper-parallel/hyper-rl:qwen3_8-v0.23.0.post1-agent-arm64
FROM ${AGENT_BASE}

LABEL org.hyperparallel.flash-attention-source=c7528a4bdb0a33f21e181cd25108c1e60c11d061 \
    org.hyperparallel.catlass-source=c8948c340c4f30fb5964ccdd6e3a0bc7615fe202

ARG FA_WHEEL_SHA256
ARG BATCH_WHEEL_SHA256
ARG PYARROW_WHEEL_SHA256
ARG TORCHDATA_WHEEL_SHA256
COPY wheels/flash_attn_npu-0.2.0b1-cp312-cp312-linux_aarch64.whl \
    wheels/batch_invariant_ops-1.0.0-cp312-cp312-linux_aarch64.whl \
    wheels/pyarrow-24.0.0-cp312-cp312-manylinux_2_28_aarch64.whl \
    wheels/torchdata-0.11.0-py3-none-any.whl /tmp/consistency-wheels/
COPY downloads/cann-ops-batch_invariant-910b-1.0.0-linux.aarch64.run /tmp/batch-kernel.run
RUN test -n "${FA_WHEEL_SHA256}" && test -n "${BATCH_WHEEL_SHA256}" && test -n "${PYARROW_WHEEL_SHA256}" \
    && test -n "${TORCHDATA_WHEEL_SHA256}" \
    && printf '%s\n' \
    "${FA_WHEEL_SHA256}  /tmp/consistency-wheels/flash_attn_npu-0.2.0b1-cp312-cp312-linux_aarch64.whl" \
    "${BATCH_WHEEL_SHA256}  /tmp/consistency-wheels/batch_invariant_ops-1.0.0-cp312-cp312-linux_aarch64.whl" \
    "${PYARROW_WHEEL_SHA256}  /tmp/consistency-wheels/pyarrow-24.0.0-cp312-cp312-manylinux_2_28_aarch64.whl" \
    "${TORCHDATA_WHEEL_SHA256}  /tmp/consistency-wheels/torchdata-0.11.0-py3-none-any.whl" \
    '6d6454da000164aee9e330582f3b7b6f7c2a38f668c2bd6d837d3b0aebf27f98  /tmp/batch-kernel.run' \
    | sha256sum --check \
    && bash /tmp/batch-kernel.run --quiet \
    && python -m pip install --no-index --no-deps /tmp/consistency-wheels/*.whl \
    && python -c "from importlib.metadata import version; \
assert version('flash-attn-npu') == '0.2.0b1'; assert version('batch-invariant-ops') == '1.0.0'; \
assert version('pyarrow') == '24.0.0'; assert version('torchdata') == '0.11.0'" \
    && rm -rf /tmp/consistency-wheels /tmp/batch-kernel.run

# Custom-op paths must be present before the bridge initializes its native library.
ENV ASCEND_CUSTOM_OPP_PATH=/usr/local/Ascend/cann-9.1.0/opp/vendors/batch_invariant:${ASCEND_CUSTOM_OPP_PATH}
ENV LD_LIBRARY_PATH=/usr/local/Ascend/cann-9.1.0/opp/vendors/batch_invariant/op_api/lib:${LD_LIBRARY_PATH}
