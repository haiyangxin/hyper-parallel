ARG BASE_IMAGE=quay.io/ascend/vllm-ascend@sha256:e62e85cb1bef9625cf568d0e8e2ac8e4b76f946eb6e8d9d459cfcf99565bea5d
ARG AGENT_IMAGE=swr.cn-east-3.myhuaweicloud.com/huawei-hyper-rl/hyper-rl@sha256:450b32a4a1d7818d80b832335665a7d8bece5b91827f8ee80a9f62609e939944
FROM ${AGENT_IMAGE} AS agent
FROM ${BASE_IMAGE}

# Reuse the reviewed standalone CLI without changing the official inference stack.
COPY --from=agent /opt/codex /opt/codex
ENV PATH=/opt/codex/bin:${PATH}
RUN printf '%s\n' \
    '285958769bc41cd70812524ca96631bf679635f4f1c08320ab1f31d958e81b24  /opt/codex/bin/codex' \
    '8c5723b7c2c642bb07d94166ee8effa11dc3b78166a29209df1b1983d0a5b3e9  /opt/codex/bin/codex-code-mode-host' \
    | sha256sum --check

# The build context is reference/qwen3_8_env/wheels; runtime sources stay mounted.
COPY deepseek_harness_sdk-0.1.1rc1-py3-none-any.whl \
    deepseek_harness_runtime_bin-0.1.1rc1-py3-none-manylinux_2_28_aarch64.whl /tmp/agent-wheels/
RUN printf '%s\n' \
    '2113aec229039da435bc44b275b487216d2b1c308d850521b88cea6ce3c1b762  /tmp/agent-wheels/deepseek_harness_sdk-0.1.1rc1-py3-none-any.whl' \
    'e73987c6c08d8322bce2b8b2ce75db6a139ecf546417b6015ce7a8de5e5f19b5  /tmp/agent-wheels/deepseek_harness_runtime_bin-0.1.1rc1-py3-none-manylinux_2_28_aarch64.whl' \
    | sha256sum --check \
    && python -m pip install --no-index --no-deps /tmp/agent-wheels/*.whl \
    && python -c 'from importlib.metadata import version; assert version("pydantic").split(".")[0] == "2"' \
    && test "$(codex --version)" = 'codex-cli 0.152.1' \
    && rm -rf /tmp/agent-wheels
